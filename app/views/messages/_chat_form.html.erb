<%# locals: (chat: nil, message_hint: nil) %>

<div id="chat-form" class="space-y-2">
  <% model = chat && chat.persisted? ? [chat, Message.new] : Chat.new %>

  <%= form_with model: model,
                class: "flex lg:flex-col gap-2 bg-container px-2 py-1.5 rounded-full lg:rounded-lg shadow-border-xs",
                data: { chat_target: "form" } do |f| %>

    <%# In the future, this will be a dropdown with different AI models %>
    <%= f.hidden_field :ai_model, value: Provider::Openai::MODELS.first %>

    <%= f.text_area :content, placeholder: "Ask a question about your finances...", value: message_hint,
                  class: "w-full border-0 text-sm resize-none px-1 bg-transparent focus-visible:outline-2 focus-visible:outline-gray-900 focus-visible:outline-offset-2 rounded-lg",
                  data: { chat_target: "input", action: "input->chat#autoResize keydown->chat#handleInputKeyDown" },
                  aria: { label: "Ask a question about your finances" },
                  rows: 1 %>

    <div class="flex items-center justify-between gap-1">
      <div class="items-center gap-1 hidden lg:flex">
        <%# These are disabled for now, but in the future, will all open specific menus with their own context and search %>
        <% [
          ["plus", "Add attachment"],
          ["command", "Command palette"],
          ["at-sign", "Mention account"],
          ["mouse-pointer-click", "Select element"]
        ].each do |icon_name, label| %>
          <%= icon(icon_name, as_button: true, disabled: true, aria: { label: "#{label} (coming soon)" }, class: "cursor-not-allowed min-w-[44px] min-h-[44px]", title: "Coming soon") %>
        <% end %>
      </div>

      <%= icon("arrow-up", as_button: true, type: "submit", aria: { label: "Send message" }, class: "min-w-[44px] min-h-[44px]") %>
    </div>
  <% end %>

  <p class="text-xs text-gray-600 theme-dark:text-gray-400">AI responses are informational only and are not financial advice.</p>
</div>
