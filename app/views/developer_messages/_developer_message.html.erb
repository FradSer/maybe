<%# locals: (developer_message:) %>

<div id="<%= dom_id(developer_message) %>" class="my-2 px-3 py-2 rounded-lg max-w-[85%] ml-auto border <%= developer_message.debug? ? "bg-yellow-50 theme-dark:bg-yellow-900/20 border-yellow-200 theme-dark:border-yellow-800" : "bg-blue-50 theme-dark:bg-blue-900/20 border-blue-200 theme-dark:border-blue-800" %>">
  <span class="text-secondary text-xs"><%= developer_message.debug? ? "Debug message (internal only)" : "System instruction (sent to AI)" %></span>
  <p class="text-primary text-sm"><%= developer_message.content %></p>
</div>
