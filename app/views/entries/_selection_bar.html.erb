<div class="fixed bottom-6 z-10 flex items-center justify-between rounded-xl bg-inverse px-4 text-sm text-inverse w-[90%] md:w-[420px] py-1.5">
  <div class="flex items-center gap-2">
    <%= check_box_tag "entry_selection", 1, true, class: "checkbox checkbox--dark", aria: { label: "Deselect all entries" }, data: { action: "bulk-select#deselectAll" } %>

    <p data-bulk-select-target="selectionBarText"></p>
  </div>

  <div class="flex items-center gap-1 text-subdued">
    <%= form_with url: transactions_bulk_deletion_path, data: { turbo_confirm: CustomConfirm.for_resource_deletion("entry").to_data_attribute, turbo_frame: "_top" } do %>
      <button type="button" data-bulk-select-scope-param="bulk_delete" data-action="bulk-select#submitBulkRequest" class="p-3 group hover:bg-inverse flex items-center justify-center rounded-md min-w-[44px] min-h-[44px]" title="Delete" aria-label="Delete selected entries">
        <%= icon "trash-2", class: "group-hover:text-inverse" %>
      </button>
    <% end %>
  </div>
</div>
