<%# locals: (pagy:) %>

<nav class="flex w-full items-center justify-between" aria-label="Pagination">
  <div class="flex items-center gap-1">
    <div>
      <% if pagy.previous %>
        <%= link_to pagy.page_url(pagy.previous),
              data: { turbo_frame: :_top },
              aria: { label: "Previous page" },
              class: "inline-flex items-center justify-center min-w-[44px] min-h-[44px] p-2 text-sm font-medium text-secondary bg-container-inset hover:bg-container-hover hover:text-primary rounded-lg" do %>
          <%= icon("chevron-left") %>
        <% end %>
      <% else %>
        <div class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] p-2 text-sm font-medium text-subdued opacity-50">
          <%= icon("chevron-left") %>
        </div>
      <% end %>
    </div>
    <div class="rounded-xl p-1 bg-container-inset">
      <% pagy_series(pagy).each do |series_item| %>
        <% if series_item.is_a?(Integer) %>
          <%= link_to pagy.page_url(series_item),
                data: { turbo_frame: :_top },
                aria: { label: "Page #{series_item}" },
                class: "rounded-md min-w-[44px] min-h-[44px] inline-flex items-center justify-center text-sm font-medium text-secondary hover:bg-surface-hover hover:text-primary" do %>
            <%= series_item %>
          <% end %>
        <% elsif series_item.is_a?(String) %>
          <%= link_to pagy.page_url(series_item),
                data: { turbo_frame: :_top },
                aria: { label: "Page #{series_item}", current: "page" },
                class: "rounded-md min-w-[44px] min-h-[44px] inline-flex items-center justify-center bg-container border border-secondary shadow-xs text-sm font-medium text-primary" do %>
            <%= series_item %>
          <% end %>
        <% elsif series_item == :gap %>
          <span class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] text-sm font-medium text-secondary">...</span>
        <% end %>
      <% end %>
    </div>
    <div>
      <% if pagy.next %>
        <%= link_to pagy.page_url(pagy.next),
              data: { turbo_frame: :_top },
              aria: { label: "Next page" },
              class: "inline-flex items-center justify-center min-w-[44px] min-h-[44px] p-2 text-sm font-medium text-secondary bg-container-inset hover:bg-container-hover hover:text-primary rounded-lg" do %>
          <%= icon("chevron-right") %>
        <% end %>
      <% else %>
        <div class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] p-2 text-sm font-medium text-subdued opacity-50">
          <%= icon("chevron-right") %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="flex items-center gap-4">
    <%= select_tag :per_page,
                   options_for_select(["10", "20", "30", "50"], pagy.limit),
                   data: { controller: "selectable-link" },
                   aria: { label: "Items per page" },
                   class: "min-h-[44px] py-1.5 pr-8 text-sm text-primary font-medium bg-container-inset border border-secondary rounded-lg focus-visible:outline-2 focus-visible:outline-gray-900 focus-visible:outline-offset-2" %>
  </div>
</nav>
