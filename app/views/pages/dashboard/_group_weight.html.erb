<%# locals: (weight:, color:) %>

<% effective_weight = weight.presence || 0 %>

<div class="w-full flex items-center justify-between gap-2" role="img" aria-label="<%= number_to_percentage(effective_weight, precision: 2) %> weight">
  <div class="w-full h-2 rounded-full bg-surface-inset">
    <div class="h-2 rounded-full" style="width: <%= effective_weight %>% ; background-color: <%= color %>;"></div>
  </div>
  <p class="text-sm"><%= number_to_percentage(effective_weight, precision: 2) %></p>
</div>
