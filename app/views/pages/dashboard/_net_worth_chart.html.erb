<%# locals: (balance_sheet:, period:, **args) %>

<div id="net-worth-chart">
  <% series = balance_sheet.net_worth_series(period: period) %>
  <div class="flex justify-between gap-4 px-4">
    <div class="space-y-2">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <p class="text-sm text-secondary font-medium"><%= t(".title") %></p>
        </div>

        <p class="text-primary -space-x-0.5 text-3xl font-medium <%= "opacity-50" if balance_sheet.syncing? %>">
          <%= series.trend.current.format %>
        </p>

        <% if series.trend.nil? %>
          <p class="text-sm text-secondary"><%= t(".data_not_available") %></p>
        <% else %>
          <%= render partial: "shared/trend_change", locals: { trend: series.trend, comparison_label: period.comparison_label } %>
          <% if Current.family.latest_sync_completed_at.present? %>
            <p class="text-xs text-secondary mt-1">
              Updated <%= time_ago_in_words(Current.family.latest_sync_completed_at) %> ago
            </p>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= form_with url: root_path, method: :get, data: { controller: "auto-submit-form" } do |form| %>
      <%= form.select :period,
                    Period.as_options,
                    { selected: period.key },
                    data: { "auto-submit-form-target": "auto" },
                    aria: { label: "Select time period" },
                    class: "bg-container border border-secondary font-medium rounded-lg px-3 py-2 text-sm pr-7 cursor-pointer text-primary min-w-[44px] min-h-[44px] focus-visible:outline-2 focus-visible:outline-gray-900 focus-visible:outline-offset-2" %>
    <% end %>
  </div>

  <% if series.any? %>
    <div
    id="netWorthChart"
    class="w-full flex-1 min-h-52"
    role="img"
    aria-label="Net worth chart"
    aria-describedby="net-worth-chart-data"
    data-controller="time-series-chart"
    data-time-series-chart-data-value="<%= series.to_json %>"></div>

    <details id="net-worth-chart-data" class="mx-4 mt-2 rounded-lg bg-surface-inset p-3">
      <summary class="cursor-pointer text-sm font-medium text-primary">View net worth data</summary>
      <div class="mt-2 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">Net worth by date</caption>
          <thead class="text-left text-gray-600 theme-dark:text-gray-400">
            <tr><th scope="col" class="pr-4">Date</th><th scope="col" class="text-right">Net worth</th></tr>
          </thead>
          <tbody>
            <% series.each do |value| %>
              <tr class="border-t border-tertiary"><th scope="row" class="py-1 pr-4 text-left font-normal text-gray-600 theme-dark:text-gray-400"><%= value.date_formatted %></th><td class="py-1 text-right font-mono text-primary"><%= value.value.format %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% else %>
    <div class="w-full h-full flex items-center justify-center">
      <p class="text-secondary text-sm"><%= t(".data_not_available") %></p>
    </div>
  <% end %>

</div>
