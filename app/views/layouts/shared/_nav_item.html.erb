<%# locals:(name:, path:, icon:, icon_custom:, active:, mobile_only: false) %>

<%= link_to path, class: "space-y-1 group block relative pb-1" do %>
  <div class="grow flex flex-col md:flex-row gap-1 items-center">
    <%= tag.div class: class_names("w-4 h-1 md:w-1 md:h-4 rounded-bl-sm rounded-br-sm md:rounded-tr-sm md:rounded-br-sm md:rounded-bl-none", "bg-nav-indicator" => active) %>

    <%= tag.div class: class_names(
      "w-8 h-8 min-w-[44px] min-h-[44px] flex items-center justify-center mx-auto rounded-lg p-1.5",
      active ? "bg-container shadow-xs text-primary" : "group-hover:bg-surface-hover text-secondary"
    ) do %>
      <%= icon(icon, color: active ? "current" : "default", custom: icon_custom) %>
    <% end %>
  </div>

  <div class="grow flex justify-center md:pl-2">
    <%= tag.p class: class_names("font-medium text-xs", active ? "text-primary" : "text-secondary") do %>
      <%= name %>
    <% end %>
  </div>
<% end %>
