<%# ============================================================
   App layout — three-panel responsive shell
   ------------------------------------------------------------
   Desktop (md+):  [left-nav 84px] [account sidebar 320px] [content] [AI sidebar 400px]
   Mobile:         [top nav] [content] [bottom nav] + slide-in account drawer

   Responsive collapse is driven by app_layout_controller.js using
   window.innerWidth with hysteresis. Widths/timing come from CSS variables
   defined on .app-layout in application.css.
   ============================================================ %>

<% mobile_nav_items = [
  { name: "Home", path: root_path, icon: "pie-chart", icon_custom: false, active: page_active?(root_path) },
  { name: "Transactions", path: transactions_path, icon: "credit-card", icon_custom: false, active: page_active?(transactions_path) },
  { name: "Budgets", path: budgets_path, icon: "map", icon_custom: false, active: page_active?(budgets_path) },
  { name: "Assistant", path: chats_path, icon: "icon-assistant", icon_custom: true, active: page_active?(chats_path) }
] %>

<% desktop_nav_items = mobile_nav_items.reject { |item| item[:mobile_only] } %>

<%= render "layouts/shared/htmldoc" do %>
  <div
    class="app-layout flex flex-col md:flex-row md:gap-3 h-full bg-surface"
    data-controller="app-layout"
    data-app-layout-left-open-value="<%= Current.user.show_sidebar? %>"
    data-app-layout-right-open-value="<%= Current.user.show_ai_sidebar? %>"
    data-app-layout-left-sidebar-width-value="320"
    data-app-layout-left-sidebar-min-width-value="280"
    data-app-layout-right-sidebar-width-value="400"
    data-app-layout-right-sidebar-min-width-value="360"
    data-app-layout-content-min-width-value="480"
    data-app-layout-user-id-value="<%= Current.user.id %>">

    <%# ======================= MOBILE ======================= %>

    <%# Backdrop for the slide-in drawer %>
    <div
      class="md:hidden fixed inset-0 z-30 bg-overlay opacity-0 pointer-events-none transition-opacity duration-300"
      data-app-layout-target="mobileBackdrop"
      data-action="click->app-layout#closeMobileSidebar">
    </div>

    <%# Slide-in account drawer (from the left, translateX animation) %>
    <aside
      class="md:hidden app-layout__drawer fixed inset-y-0 left-0 z-40 w-80 max-w-[85%] bg-surface shadow-lg"
      data-app-layout-target="mobileSidebar"
      aria-label="Account sidebar"
      aria-hidden="true">
      <div class="h-full overflow-y-auto pt-[calc(env(safe-area-inset-top)+0.75rem)] pr-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)] pl-3">
        <div class="mb-2">
          <%= icon("x", as_button: true, data: { action: "app-layout#closeMobileSidebar" }) %>
        </div>

        <%= render(
          "accounts/account_sidebar_tabs",
          family: Current.family,
          active_tab: @account_group_tab,
          mobile: true
        ) %>
      </div>
    </aside>

    <%# Mobile top navigation %>
    <nav class="md:hidden flex justify-between items-center p-3" aria-label="Mobile top navigation">
      <%= icon("panel-left", as_button: true, data: { action: "app-layout#openMobileSidebar"}) %>

      <%= link_to root_path, class: "block" do %>
        <%= image_tag "logomark-color.svg", class: "w-9 h-9 mx-auto" %>
      <% end %>

      <%= render "users/user_menu", user: Current.user, placement: "bottom-end", offset: 12 %>
    </nav>

    <%# ======================= DESKTOP ======================= %>
    <%# Desktop panels are kept together in a single section.
        The hidden md:block guard ensures they are invisible on mobile,
        and the md:hidden guard on mobile elements ensures they are
        invisible on desktop. Focus order follows the DOM order within
        each breakpoint's visible set. %>

    <%# Fixed left navigation rail (84px) %>
    <div class="hidden md:block app-layout__nav-rail">
      <nav class="h-full flex flex-col shrink-0 w-[84px] min-w-[84px] py-4" aria-label="Main navigation">
        <div class="pl-2 mb-3">
          <%= link_to root_path, class: "block" do %>
            <%= image_tag "logomark-color.svg", class: "w-9 h-9 mx-auto" %>
          <% end %>
        </div>

        <ul class="space-y-0.5">
          <% desktop_nav_items.each do |nav_item| %>
            <li>
              <%= render "layouts/shared/nav_item", **nav_item %>
            </li>
          <% end %>
        </ul>

        <div class="pl-2 mt-auto mx-auto flex flex-col gap-2">
          <%= render DS::Button.new(
            variant: "icon",
            icon: "message-circle-question",
            data: { action: "intercom#show" },
            class: "focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:outline-none"
          ) %>

          <%= render "users/user_menu", user: Current.user %>
        </div>
      </nav>
    </div>

    <%# Left account sidebar (collapsible, never shrinks) %>
    <%= tag.div class: class_names(
        "hidden md:block app-layout__sidebar app-layout__sidebar--left",
        Current.user.show_sidebar? ? "app-layout__sidebar--open" : "app-layout__sidebar--closed",
       ),
       data: { app_layout_target: "leftSidebar" },
       aria: { label: "Account sidebar" } do %>
      <% if content_for?(:sidebar) %>
        <div class="h-full overflow-y-auto py-4 pr-3">
          <%= yield :sidebar %>
        </div>
      <% else %>
        <div class="h-full flex flex-col py-4">
          <div class="overflow-y-auto grow pr-3">
            <%= render "accounts/account_sidebar_tabs", family: Current.family, active_tab: @account_group_tab %>
          </div>

          <% if Current.family.trialing? && !self_hosted? %>
            <div class="px-4 py-3 space-y-4 bg-container shadow-border-xs rounded-xl">
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-sm font-medium text-primary">Free trial</p>
                  <p class="text-sm text-secondary"><%= Current.family.days_left_in_trial %> days remaining</p>
                </div>

                <%= render DS::Link.new(
                  text: "Upgrade",
                  href: upgrade_subscription_path,
                ) %>
              </div>

              <div class="flex items-center gap-0.5 h-1.5">
                <div class="h-full bg-warning rounded-full" style="width: <%= Current.family.percentage_of_trial_completed %>%"></div>
                <div class="h-full bg-surface-inset rounded-full" style="width: <%= Current.family.percentage_of_trial_remaining %>%"></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%# Main content (shrinks first, centered via justify-center on parent) %>
    <%= tag.main class: class_names("grow overflow-y-auto px-3 sm:px-5 md:px-8 py-4 w-full min-w-[480px]"), style: "overscroll-behavior: contain", data: { app_layout_target: "content" } do %>
      <div class="hidden md:flex gap-2 items-center justify-between mb-6">
        <div class="flex items-center gap-2">
          <%= icon("panel-left", as_button: true, data: { action: "app-layout#toggleLeftSidebar" }, class: "focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:outline-none rounded-lg") %>

          <% if content_for?(:breadcrumbs) %>
            <%= yield :breadcrumbs %>
          <% else %>
            <%= render "layouts/shared/breadcrumbs", breadcrumbs: @breadcrumbs %>
          <% end %>
        </div>
        <%= icon("panel-right", as_button: true, data: { action: "app-layout#toggleRightSidebar" }, class: "focus-visible:ring-2 focus-visible:ring-gray-500 focus-visible:outline-none rounded-lg") %>
      </div>

      <% if content_for?(:page_header) %>
        <%= yield :page_header %>
      <% end %>

      <%= yield %>
    <% end %>

    <%# Right AI chat sidebar (collapsible, never shrinks) %>
    <%= tag.div class: class_names(
          "hidden md:block app-layout__sidebar app-layout__sidebar--right",
          Current.user.show_ai_sidebar? ? "app-layout__sidebar--open" : "app-layout__sidebar--closed",
        ),
        data: { app_layout_target: "rightSidebar" },
        aria: { label: "AI chat sidebar" } do %>
      <div class="h-full">
        <%= tag.div id: "chat-container", class: "relative h-full", data: { controller: "chat hotkey", turbo_permanent: true } do %>
          <div class="flex flex-col h-full justify-between">
            <%= turbo_frame_tag chat_frame, src: chat_view_path(@chat), loading: "lazy", class: "h-full" do %>
              <div class="flex justify-center items-center h-full">
                <%= icon("loader-circle", class: "animate-spin") %>
              </div>
            <% end %>
          </div>

          <% unless Current.user.ai_enabled? %>
            <div class="absolute backdrop-blur-lg inset-0 h-full w-full flex flex-col justify-center items-center px-4">
              <%= render "chats/ai_consent" %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# ======================= MOBILE ======================= %>

    <%# Mobile bottom navigation %>
    <%= tag.nav class: "md:hidden bg-surface shrink-0 z-10 pb-[env(safe-area-inset-bottom)] border-t border-tertiary flex justify-around", aria: { label: "Mobile bottom navigation" } do %>
      <% mobile_nav_items.each do |nav_item| %>
        <%= render "layouts/shared/nav_item", **nav_item %>
      <% end %>
    <% end %>
  </div>
<% end %>
