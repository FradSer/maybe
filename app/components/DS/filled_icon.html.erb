<%= tag.div style: transparent? ? container_styles : nil,
            class: container_classes do %>
  <% if icon %>
    <%= helpers.icon(icon, size: icon_size, color: "current") %>
  <% elsif text %>
    <%# Decorative initial derived from an adjacent visible label; hidden from AT so lone letters aren't announced %>
    <%= tag.span text.first, class: text_classes, "aria-hidden": "true" %>
  <% end %>
<% end %>
